# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง ไฟล์ .env.local จะไม่ถูกเอาเข้า git
# ที่อยู่ฐานข้อมูล PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/web"

# ที่อยู่หน้าเว็บ ใช้สร้างลิงก์ของแต่ละหน้าและลิงก์เชิญผู้ใช้ ตอนขึ้นเว็บจริงต้องเปลี่ยนเป็นโดเมนจริง
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# รหัสลับสำหรับการล็อกอินหลังบ้าน ใส่ตัวอักษรสุ่มอย่างน้อย 32 ตัว ต้องมีเมื่อขึ้นเว็บจริง
# สร้างรหัสได้ด้วยคำสั่งนี้
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-32+-random-characters"

# ผู้ดูแลคนแรกของเว็บจริง ใช้ครั้งเดียวตอนเปิดเว็บกับฐานข้อมูลเปล่าครั้งแรก ตอนพัฒนาไม่ต้องใส่
# รหัสผ่านยาว 8 ตัวขึ้นไปและมีทั้งตัวอักษรและตัวเลข ล็อกอินได้แล้วลบสองบรรทัดนี้ออกได้
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD=""
